{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Text-Detector",
  "version": "0.2.0",
  "identifier": "com.aitextdetector.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && py -3 ../scripts/build_base_runtime.py"
  },
  "app": {
    "windows": [
      {
        "title": "AI Text Detector",
        "width": 1100,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend-bundle/": "backend/",
      "../models/manifest.json": "models/manifest.json",
      "../runtime-base/": "runtime/"
    },
    "windows": {
      "bundleVCRuntime": true,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
