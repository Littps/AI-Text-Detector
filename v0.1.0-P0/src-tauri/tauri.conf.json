{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Text-Detector",
  "version": "0.1.0",
  "identifier": "io.github.littps.ai-text-detector",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI-Text-Detector",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ws://127.0.0.1:*; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
